{
  "expo": {
    "name": "Wikalinggo",
    "slug": "wikalinoapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wikalinggo-flat-icon.png",
    "scheme": "wikalinoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jxaces.wikalinoapp",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jxaces.wikalinoapp",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9ED",
        "foregroundImage": "./assets/images/wikalinggo-flat-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/wikalinggo-flat-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/wikalinggo-flat-wordmark.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9ED",
          "dark": {
            "backgroundColor": "#FFF9ED"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c658340d-a76c-4922-b47a-343ad1710a6d"
      }
    },
    "owner": "jxaces01"
  }
}
