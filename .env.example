# Public settings: sync is enabled only when these contain real connection values.
EXPO_PUBLIC_SYNC_MODE=supabase
EXPO_PUBLIC_API_URL=https://wikalino-backend.onrender.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Never put SUPABASE_SECRET_KEY in this file or in any EXPO_PUBLIC variable.
# To test against the local memory backend instead:
# EXPO_PUBLIC_SYNC_MODE=local
# EXPO_PUBLIC_API_URL=http://localhost:3001
# Local mode uses a separate test identity per device. No Supabase keys needed.
